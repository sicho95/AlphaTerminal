# Générer par : python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
AT_BOOTSTRAP_CODE=REMPLACER_PAR_SECRET_ALEATOIRE_LONG

# Requis pour authentifier la diffusion Web Push
AT_VAPID_SUBJECT=mailto:CONTACT_A_CONFIGURER

# Chemin absolu et persistant NAS, HORS dépôt Git et HORS répertoires de releases
AT_HOST_DATA_DIR=/chemin/absolu/AlphaTerminal/data
